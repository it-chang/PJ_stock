<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <system.webServer>
        <directoryBrowse enabled="true" />
        <!-- 每次都向伺服器確認是否有新版（沒變只回 304），避免改了 JS / 每日 Excel 卻讀到舊快取 -->
        <staticContent>
            <clientCache cacheControlMode="DisableCache" />
        </staticContent>
    </system.webServer>
</configuration>
